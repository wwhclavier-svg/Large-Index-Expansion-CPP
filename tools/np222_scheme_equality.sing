// 最终验证: 重构 GB (J_recon) 与真特征理想消去 A 后 (J_true_B) 是否相等
// p = 179424673, B_i = b_i, A_i = 1/B_i

// ---- 10 变量环: 真理想 ----
ring r = 179424673,(A1,A2,A3,A4,A5,B1,B2,B3,B4,B5),(dp(5),dp(5));
ideal Jt =
179424665 + 179424669*A1 + 179424671*A2 + 179424669*A5 + 179424671*A2*B1 + 179424671*A5*B1 + 2*A5*B4,
179424671*A1 + 179424669*A5 + 2*A1*B2 + 2*A5*B2 + 2*A2*B3 + 179424671*A5*B3 + 2*A1*B4 + 179424671*A1*B5 + 179424671*A2*B5,
2*A1 + 2*A2 + 4*A5 + 2*A2*B1 + 2*A5*B1 + 179424671*A1*B2 + 179424671*A5*B2 + 2*A5*B3 + 179424671*A5*B4,
179424671*A3 + 179424669*A5 + 2*A4*B1 + 179424671*A5*B1 + 2*A3*B2 + 2*A3*B4 + 2*A5*B4 + 179424671*A3*B5 + 179424671*A4*B5,
179424665 + 179424669*A3 + 179424671*A4 + 179424669*A5 + 2*A5*B2 + 179424671*A4*B3 + 179424671*A5*B3,
2*A3 + 2*A4 + 4*A5 + 2*A5*B1 + 179424671*A5*B2 + 2*A4*B3 + 2*A5*B3 + 179424671*A3*B4 + 179424671*A5*B4,
179424672 + A1*B1,
179424672 + A2*B2,
179424672 + A3*B3,
179424672 + A4*B4,
179424672 + A5*B5;
Jt = std(Jt);
print("vdim(J_true, 10var) = " + string(vdim(Jt)));
ideal Je = eliminate(Jt, A1*A2*A3*A4*A5);
print("size(elim) = " + string(size(Je)));

// ---- 5 变量环: 比较 ----
ring r5 = 179424673,(B1,B2,B3,B4,B5),lp;
ideal Je = imap(r, Je);
ideal GB =
106378895 + 136522240*B5 + 151301517*B5^2 + 36097588*B5^3 + 159453161*B5^4 + 68314286*B5^5 + 133385628*B5^6 + 66364974*B5^7 + 115629234*B5^8 + B5^9,
3959526 + 157273479*B4 + 167116916*B5 + 57593106*B4*B5 + 125512474*B5^2 + 79744301*B4*B5^2 + 36978649*B5^3 + B4*B5^3 + 170876271*B5^4 + 29839504*B5^5 + 135154013*B5^6 + 153673910*B5^7 + 131531368*B5^8,
60712635 + B4 + B4^2 + 68280375*B5 + 89712352*B4*B5 + 118331802*B5^2 + 89712350*B4*B5^2 + 153472491*B5^3 + 94571044*B5^4 + 150879094*B5^5 + 47628948*B5^6 + 61918434*B5^7 + 68449797*B5^8,
151007767 + B3 + 51264203*B4 + 157059271*B5 + 140976568*B4*B5 + 697990*B5^2 + 12816077*B4*B5^2 + 88997531*B5^3 + 154402553*B5^4 + 149573996*B5^5 + 73088622*B5^6 + 127894524*B5^7 + 93064198*B5^8,
178387960 + B2 + B4 + 37690773*B5 + 30425947*B5^2 + 176386995*B5^3 + 63071925*B5^4 + 62023620*B5^5 + 175315249*B5^6 + 108836427*B5^7 + 117161406*B5^8,
119849801 + B1 + 128160470*B4 + 111984907*B5 + 38448105*B4*B5 + 124555617*B5^2 + 166608596*B4*B5^2 + 137818493*B5^3 + 72265098*B5^4 + 150058754*B5^5 + 152249157*B5^6 + 147440884*B5^7 + 129647558*B5^8;
ideal G = std(GB);
ideal E = std(Je);
print("vdim(J_recon) = " + string(vdim(G)));
print("vdim(J_true_B) = " + string(vdim(E)));

// recon subseteq true ?
int ok1 = 1;
for (int i = 1; i <= size(GB); i++) { if (NF(GB[i], E) != 0) { ok1 = 0; print("GB["+string(i)+"] NOT in J_true_B"); } }
if (ok1) { print("J_recon subseteq J_true_B: YES"); }

// true subseteq recon ?
int ok2 = 1;
for (int j = 1; j <= size(Je); j++) { if (NF(Je[j], G) != 0) { ok2 = 0; print("Je["+string(j)+"] NOT in J_recon"); } }
if (ok2) { print("J_true_B subseteq J_recon: YES"); }

if (ok1 and ok2) { print("SCHEME EQUALITY: J_recon == J_true_B"); }
quit;
